# Django REST API base URL (no trailing slash).
# Used by all frontend API calls via src/lib/apiBase.ts (getApiBaseUrl).
#
# Production (Render backend — set the same value in Render dashboard env vars):
NEXT_PUBLIC_API_URL=https://checkin-backend-z1f2.onrender.com
#
# Local Django:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# Local dev on phone (same Wi‑Fi — PC LAN IP, not 127.0.0.1):
# NEXT_PUBLIC_API_URL=http://192.168.1.5:8000
