# Deployed Django API (Render production — also set in Render dashboard)
NEXT_PUBLIC_API_URL=https://checkin-backend-z1f2.onrender.com

# Local Django API (npm run dev on localhost / LAN)
NEXT_PUBLIC_API_URL_LOCAL=http://127.0.0.1:8000

# false = use Render API even on localhost (when Django is not running locally)
# NEXT_PUBLIC_USE_LOCAL_API=false

# Phone on same Wi‑Fi — use your PC LAN IP instead of 127.0.0.1:
# NEXT_PUBLIC_API_URL_LOCAL=http://192.168.1.5:8000
